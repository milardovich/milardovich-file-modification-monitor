{
    "name": "milardovich/wp-code-guardian",
    "description": "Detects local modifications in WordPress plugins and themes against pristine WordPress.org copies.",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "authors": [
        {
            "name": "Sergio Milardovich",
            "homepage": "https://milardovich.com.ar"
        }
    ],
    "require": {
        "php": ">=7.2",
        "sebastian/diff": "^4.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.0",
        "squizlabs/php_codesniffer": "^3.5"
    },
    "autoload": {
        "psr-4": {
            "WPCodeGuardian\\": "includes/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "WPCodeGuardian\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "cs": "phpcs",
        "cs-fix": "phpcbf"
    },
    "config": {
        "sort-packages": true
    }
}
