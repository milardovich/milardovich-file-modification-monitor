{
    "name": "milardovich/file-modification-monitor",
    "description": "Detects local modifications in WordPress plugins and themes against pristine WordPress.org copies.",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "authors": [
        {
            "name": "Sergio Milardovich",
            "homepage": "https://milardovich.com.ar"
        }
    ],
    "require": {
        "php": ">=8.3",
        "sebastian/diff": "^7.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.0",
        "squizlabs/php_codesniffer": "^3.5"
    },
    "autoload": {
        "psr-4": {
            "MilardovichFMM\\": "includes/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "MilardovichFMM\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "cs": "phpcs",
        "cs-fix": "phpcbf"
    },
    "config": {
        "sort-packages": true,
        "platform": {
            "php": "8.3"
        }
    }
}
